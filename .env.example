# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# URL of the API (Back_MedLout)
NEXT_PUBLIC_API_URL=https://your-backend.vercel.app

# WhatsApp number that receives orders and contact messages (digits only, international format)
NEXT_PUBLIC_WHATSAPP_NUMBER=212682337693

# Public address of the shop (for Google). Change it when the .com domain is ready.
NEXT_PUBLIC_SITE_URL=https://front-med-lout.vercel.app

# Meta (Facebook + Instagram) Pixel — leave empty to keep it off.
# Get the ID in Meta Events Manager → Data sources → your pixel.
NEXT_PUBLIC_META_PIXEL_ID=
# Currency sent with purchase values (change only if Meta reports MAD as unsupported)
NEXT_PUBLIC_META_PIXEL_CURRENCY=MAD
